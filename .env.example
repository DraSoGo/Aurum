# ===================================================================
# Aurum — environment template
#
# Copy this file to one of:
#   .env.icmarkets   (demo / paper trading — selected by test.bat)
#   .env.oanda       (live / real money    — selected by start.bat)
#   .env             (default fallback if AI_TRADER_ENV unset)
#
# Then fill in REAL values. Never commit a populated .env* — see
# .gitignore. The trading engine will refuse to start with placeholder
# credentials.
# ===================================================================

ENVIRONMENT=testing                    # testing | production

# ==================== Database =====================================
# Per-broker SQLite isolates trade history + magic-number stats.
DB_PATH=data/aurum.db

# ==================== Frontend / CORS ==============================
VITE_REFRESH_INTERVAL=300000
CLAWTRADER_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ==================== Market data API keys =========================
# Free tiers are fine. Get keys at:
#   https://twelvedata.com/
#   https://site.financialmodelingprep.com/
#   https://www.alphavantage.co/
#   https://gnews.io/
TWELVE_DATA_API_KEY=YOUR_TWELVE_DATA_KEY
FMP_API_KEY=YOUR_FMP_KEY
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_KEY
GNEWS_API_KEY=YOUR_GNEWS_KEY

# ==================== MT5 broker credentials =======================
# Aurum talks to MetaTrader 5 over the official Python IPC bridge.
# MAGIC_NUMBER must be unique per broker profile so positions, stats,
# and self-tuner state never mix between profiles.
MT5_LOGIN=0
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_BROKER_SERVER          # e.g. ICMarketsSC-Demo, OANDA_Global-Live-1
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_SYMBOL=XAUUSD
LOT_SIZE=0.01
MAGIC_NUMBER=202400                    # unique int per broker profile

# ==================== Risk: stop-loss budget =======================
# Adaptive SL cap: cap = max(SL_FLOOR_POINTS, atr * SL_ATR_MULT).
# Set SL_ATR_MULT=0 to fall back to static MAX_SL_POINTS only.
MAX_SL_POINTS=7.0
SL_ATR_MULT=1.5
SL_FLOOR_POINTS=3.0
MIN_FREE_MARGIN_USD=20

# ==================== Risk: trailing stop logic ====================
TRAIL_BE_ATR=0.10
TRAIL_MICRO_LOCK_PTS=0.10
TRAIL_STAGNATION_SECS=180
TRAIL_STAGNATION_ATR=0.05
TRAIL_HARD_CLOSE_SECS=1200
TRAIL_START_ATR=0.30
TRAIL_LOCK_FRAC=0.50
TRAIL_MIN_ADVANCE_PTS=0.15

# ==================== Cycle cadence ================================
AI_TRADER_INTERVAL_SECONDS=1800

# ==================== Risk gates ===================================
# Tune these for the account size you actually run on.
DAILY_LOSS_LIMIT_USD=50
WEEKLY_LOSS_LIMIT_USD=200              # 0 to disable
WEEKLY_LOSS_LIMIT_DAYS=7
MAX_CONSEC_LOSSES=3
LOSS_COOLDOWN_MIN=60
TRADE_COOLDOWN_SECS=0
MAX_SPREAD_POINTS=150
MIN_RR=2.0
RISK_PCT_PER_TRADE=0.01
MIN_LOT_SIZE=0.01
MAX_LOT_SIZE=0.10

# ==================== Session gate =================================
# London 07-16 UTC, NY 12-21 UTC, golden overlap 12-16 UTC.
TRADING_HOURS_UTC_START=7
TRADING_HOURS_UTC_END=21
TRADING_SESSION_GATE_ENABLED=true
TRADING_ENTRY_BUFFER_MIN=0

# ==================== Confidence gate ==============================
# Hard floor: any LLM decision below this confidence becomes HOLD.
MIN_CONFIDENCE_PCT=60

# ==================== Breakout gate (pre-LLM) ======================
# Skips the Claude call when no concrete trigger exists. Saves API
# spend and enforces "don't trade without a setup" discipline.
BREAKOUT_GATE_ENABLED=true
VOLUME_RATIO_MIN=1.2
BREAKOUT_GATE_POLL_SECS=60
CANDLE_MATURE_PCT=0.5
CANDLE_VOL_OVERRIDE=2.0
SECONDARY_RSI_OB=65
SECONDARY_RSI_OS=35
COUNTER_RSI_OB=65
COUNTER_RSI_OS=35

# ==================== News blackout ================================
# ForexFactory free JSON feed. Blocks new entries +/- N min around
# high-impact macro releases. Open positions are still trail-managed.
NEWS_FILTER_ENABLED=true
NEWS_BLACKOUT_MIN=30
NEWS_BLACKOUT_COUNTRIES=USD,EUR,GBP
NEWS_BLACKOUT_IMPACTS=High

# ==================== Self-Tuner ===================================
# Rule-based parameter calibration from realized PnL + shadow gates.
SELF_TUNER_ENABLED=true
SELF_TUNER_INTERVAL_MINUTES=15
SELF_TUNER_MIN_TRADES=10
SELF_TUNER_WINDOW=50
SELF_TUNER_AGENT_KILL_WR=0.25
SELF_TUNER_SINCE_ISO=

# Per-setup auto-disable (Rule 6) — reads shadow_decisions.
SELF_TUNER_SETUP_MIN_N=10
SELF_TUNER_SETUP_KILL_WR=0.30
SELF_TUNER_SETUP_KILL_EXP=0.0
SELF_TUNER_SETUP_LOOKBACK_DAYS=14
DISABLED_SETUPS=

# Shadow log rotation: prune rows older than N days on server start.
SHADOW_RETENTION_DAYS=90

# ==================== AI Trader (Anthropic Claude) =================
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY

AI_TRADER_BACKEND_URL=http://127.0.0.1:8000
AI_TRADER_AGENT_PASSWORD=CHANGE_ME
CLAUDE_TRADER_NAME=Claude-Trader
CLAUDE_TRADER_PASSWORD=CHANGE_ME

# ==================== Background tasks =============================
POSITION_REFRESH_INTERVAL=300
MAX_PARALLEL_PRICE_FETCH=5
POLYMARKET_SETTLE_INTERVAL=60
MARKET_NEWS_REFRESH_INTERVAL=900
MACRO_SIGNAL_REFRESH_INTERVAL=900
ETF_FLOW_REFRESH_INTERVAL=900
STOCK_ANALYSIS_REFRESH_INTERVAL=1800
